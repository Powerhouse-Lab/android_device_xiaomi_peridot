# Only apps targetting < Q are allowed to open /dev/ashmem directly.
# Apps must use ASharedMemory NDK API. Native code must use libcutils API.
dontaudit untrusted_app ashmem_device:chr_file open;

dontaudit system_server { 
  proc_kmsg proc_kallsyms proc_keys proc_slabinfo 
}:file getattr;

dontaudit kernel mnt_vendor_file:dir search;
dontaudit vendor_init default_prop:property_service set;
dontaudit vendor_qtidataservices_app default_prop:file { read };
dontaudit init vendor_sysfs_sd:file write;
dontaudit vold vendor_sysfs_sd:file write;
dontaudit bootanim vendor_file:file read;
dontaudit hal_power_default hal_thermal_service:service_manager find;
dontaudit vendor_qms_1 vendor_qms_prop:file read;
dontaudit vendor_qms_2 vendor_qms_prop:file read;
dontaudit platform_app vendor_file:file read;
dontaudit tee device:chr_file { read write };
dontaudit vendor_init radio_prop:file read;
dontaudit crash_dump init:process ptrace;

# SurfaceFlinger
dontaudit surfaceflinger vendor_file:file read;

dontaudit {
  hal_audio_default
  hal_graphics_composer_default
  hal_sensors_default
  rild
  vendor_adpl
  vendor_cnd
  vendor_dpmd
  vendor_hal_imsrtp
  vendor_sensors_qti
} vendor_diag_device:chr_file rw_file_perms;
